# ---------------------------------------------------------------------------
# IELTSVega — Next.js 16 (Turbopack) · TypeScript · Drizzle/Postgres
# See https://git-scm.com/docs/gitignore
# ---------------------------------------------------------------------------

content/
tools/
tasks/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Next.js build output + caches (Turbopack is the default builder in 16)
/.next/
/out/
/build
/dist
.turbo/
*.tsbuildinfo
next-env.d.ts

# Test / coverage
/coverage
/playwright-report/
/test-results/
.nyc_output/

# ---------------------------------------------------------------------------
# Secrets & environment
# Ignore every .env*, but keep committed templates so a clone can boot.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.pyc
# ---------------------------------------------------------------------------
# Database (Drizzle)
# Migrations in src/db/migrations ARE committed — they are source of truth.
# Only local dumps / scratch artifacts are ignored.
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
/tmp/
/.drizzle/
*.dump
*.sql.bak

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Deploy
.vercel
.netlify/

# Editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code — keep shared config, ignore per-user local overrides
.claude/settings.local.json

# Scratch / temp analysis scripts (kept out of history by convention)
*.tmp
.scratch/

# One-off local utility / db seeding scripts — not part of the app
utility/
audio-que-generation/


# Local-only by choice (2026-09-05). The dated SEO audits and the skill that
# produces them stay out of history: the audit reads the most recent report off
# disk to compute deltas, which still works locally, but a fresh clone starts
# with no trend history and the first run there becomes a new baseline.
seo-reports/
.claude/skills/

# The local SEO instruments those skills run (2026-09-22). Same reasoning: they
# exist for the gitignored skills above and run by hand with `npx tsx`.
# check-post-meta.ts is NOT listed here -- it is tracked on purpose.
scripts/check-keyword-coverage.ts
scripts/seo-crawl.ts
scripts/serp-parity.ts
scripts/lib/

# Content-research working notes and the keyword ownership register. Same
# reasoning as seo-reports/: the research reports are dated working notes, and
# keyword-map.md is rebuilt from Search Console whenever it is missing.
content-research/

# Reddit channel — the daily output only. policy.md, communities.md,
# activity-log.md and channels.md ARE tracked: they are the operating rules and
# the ledger the 9:1 promotion ratio is enforced from, and losing them on a
# fresh clone would mean re-scouting every subreddit from scratch.
reddit/answers/
reddit/posts/

reddit/

lesson-video/

# WhatsApp inbox — a separate Next.js project that lives here by choice
# (2026-09-22). Its own package.json, node_modules and .env.local; nothing in
# it is part of IELTSVega.
whatsapp/
