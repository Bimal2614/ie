# ─────────────────────────────────────────────────────────────────────────
# IELTSVega — environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Core (required to boot) ──
# Postgres connection string.
DATABASE_URL=
# "true" to require TLS to the database (managed/hosted Postgres).
DATABASE_SSL=false
# Absolute base URL of the app — used for canonical + OpenGraph URLs.
# Local dev: http://localhost:3000   ·   Production: https://your-domain.com
APP_URL=http://localhost:3000

# Staging database (SSL required) — used only by the db:*:staging scripts, which
# apply the SAME migration history as local. Never used by the running app.
STAGING_DATABASE_URL=

# ── AWS S3 (required for Speaking — stores uploaded audio) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Optional key prefix inside the bucket (e.g. "audio/").
S3_FOLDER_PREFIX=

# ── Speaking AI band scoring (IELTS Speaking Evaluation service — WIRED) ──
# Base URL of the service, with no trailing slash, and the shared secret it
# authenticates with (sent as the X-API-Key header; must match the service's own
# IELTS_API_KEY). BOTH are required — without them Speaking answers save but stay
# unscored (band = null). Audio is handed over as a presigned S3 URL, so the
# bucket stays private and the recording never passes through this app.
SPEAKING_API_URL=
SPEAKING_API_KEY=

# ── Writing AI band scoring (OpenAI — WIRED) ──
# Grades Writing Task 1/2 on the four IELTS criteria. Without it, Writing
# submissions save but stay unscored (band = null).
OPENAI_API_KEY=
# Optional model override (default: gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini

# ── Transactional email (SMTP — WIRED: welcome, password reset, password changed) ──
# Any provider's SMTP creds (SES, Mailgun, Postmark, Gmail, Resend-SMTP…).
# ALL FIVE are required together: with any one missing, sends are skipped and the
# whole message (reset link included) is logged to the server console outside
# production, so recovery stays testable with no mail account.
# Email addresses are NOT verified at the moment; signup sends a welcome mail.
# Port 465 uses implicit TLS, anything else uses STARTTLS.
# EMAIL_FROM must be an address the provider has authorised you to send from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IELTSVega <no-reply@your-domain.com>"

# ── Google sign-in (OAuth 2.0 — WIRED) ──
# Create a "Web application" OAuth client in Google Cloud Console and add this
# authorized redirect URI:  <APP_URL>/api/auth/google/callback
# (e.g. http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Rate limiting (all optional — these are the defaults) ──
# General per-user action limits.
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_DAY=6000
# AI (Writing/Speaking scoring) — expensive, so tighter.
RATE_LIMIT_AI_PER_DAY=100
RATE_LIMIT_AI_PER_ACCOUNT=10000
RATE_LIMIT_AI_ACCOUNT_WINDOW_DAYS=365
# Auto-deactivate an account after this many throttling violations within the window.
RATE_LIMIT_VIOLATIONS_BEFORE_DEACTIVATE=3
RATE_LIMIT_VIOLATION_WINDOW_DAYS=30

# ── Payments / Razorpay (WIRED: recurring subscriptions) ──
# Dashboard → Account & Settings → API Keys. Test keys start rzp_test_.
# Optional: with them unset the app boots and every paid button reports that
# checkout is unavailable, rather than opening one that cannot charge.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A SEPARATE secret, chosen by you when you create the webhook at
# Dashboard → Settings → Webhooks → Add New Webhook:
#   URL     <APP_URL>/api/webhooks/razorpay
#   Events  subscription.charged, subscription.activated, subscription.pending,
#           subscription.halted, subscription.cancelled, subscription.completed,
#           payment.failed
# THE RENEWALS DEPEND ON THIS. Without it the route answers 404, the first
# period is still granted by the signed checkout callback, and no cycle after
# it ever is — which looks exactly like a working integration for three months.
RAZORPAY_WEBHOOK_SECRET=
# The currency `priceCents` in src/lib/plans.ts is denominated in: cents at USD,
# paise at INR. A Razorpay account charges INR until "International Payments" is
# approved for it, so USD failing on currency means switching this to INR — and
# re-pricing the plans in that file, since $35 is not ₹0.35.

# ── Razorpay plans (created BY HAND in the dashboard) ──
# Subscriptions → Plans → Create Plan, with terms matching src/lib/plans.ts:
# for Premium today that is amount 3500, currency USD, billed every 3 months.
#
# PER-ENVIRONMENT, which is why these are here rather than beside `priceCents`:
# the test and live accounts issue different ids for the same plan, so an id
# committed into the code would work until the live keys went in.
#
# Checkout reads the plan back from Razorpay and refuses the sale if its amount,
# currency or cadence disagrees with what /pricing shows. That is deliberate: it
# is the only thing standing between "we advertise $35" and "the card is charged
# $40". A tier with no id set simply cannot be bought, and says so.
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_PRO=

# ── DevTools guard (optional) ──
# SHA-256 digest (hex) of your developer bypass token. With it set, opening any
# page as `?ddtk=<token>` exempts that tab for the session, so you can inspect
# production. The plaintext token is never shipped to the browser; only this
# digest is. Generate one with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR-TOKEN').digest('hex'))"
# Leave unset to allow no bypass at all in production.
NEXT_PUBLIC_DEVTOOLS_BYPASS_SHA256=
